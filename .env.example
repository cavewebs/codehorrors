# This frontend demo does not read these values.
# They exist so you can copy to .env if you add a backend later.
# Never commit a real .env file.

# VITE_API_URL=https://example.com
# DATABASE_URL=your-database-url
# API_KEY=your-api-key
# JWT_SECRET=your-jwt-secret
# STRIPE_SECRET_KEY=your-stripe-secret-key
# POSTGRES_PASSWORD=your-postgres-password
# DB_PASSWORD=your-db-password
# ADMIN_PASSWORD=your-admin-password
# SECRET_KEY=your-secret-key
# GF_SECURITY_ADMIN_PASSWORD=your-grafana-admin-password
# GF_SECURITY_SECRET_KEY=your-grafana-secret-key
